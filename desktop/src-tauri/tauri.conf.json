{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "徒步地球",
  "version": "0.1.0",
  "identifier": "earth.hiking.desktop",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [
      {
        "title": "徒步地球",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "url": "https://hiking-earth.hiking-earth.workers.dev/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Travel",
    "shortDescription": "徒步地球桌面端",
    "longDescription": "以 3D 地球发现全球徒步路线的桌面客户端（包裹网页端，随网页版自动更新）。",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
