export function startBackground(session: string, changed: () => void, error: (message: string) => void): boolean {
  return HikingBackground.start(session, changed, error);
}
export function stopBackground(): void { HikingBackground.stop(); }
export function backgroundBuffer(): string { return HikingBackground.buffer(); }
export function acknowledgeBackground(timestamp: number): void { HikingBackground.ack(timestamp); }
