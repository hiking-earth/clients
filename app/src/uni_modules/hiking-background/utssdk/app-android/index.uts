import { UTSAndroid } from 'io.dcloud.uts';
import { HikingBackground } from 'earth.hiking.background';
export function startBackground(session: string, changed: () => void, error: (message: string) => void): boolean {
  return HikingBackground.start(UTSAndroid.getUniActivity()!, session, changed, error);
}
export function stopBackground(): void { HikingBackground.stop(UTSAndroid.getAppContext()!); }
export function backgroundBuffer(): string { return HikingBackground.buffer(UTSAndroid.getAppContext()!); }
export function acknowledgeBackground(timestamp: number): void { HikingBackground.ack(UTSAndroid.getAppContext()!, timestamp); }
